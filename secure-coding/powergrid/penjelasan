## **Contoh Kerentanan JS Umum di CTF:**

```javascript
// Contoh kerentanan: XSS
app.get('/search', (req, res) => {
    const query = req.query.q;
    // Vulnerable: langsung render user input
    res.send(`<h1>Results for: ${query}</h1>`);
});

// Perbaikan:
app.get('/search', (req, res) => {
    const query = req.query.q;
    // Safe: escape output
    res.send(`<h1>Results for: ${escapeHtml(query)}</h1>`);
});
```

```javascript
// Contoh: Prototype Pollution
function mergeObjects(target, source) {
    for (let key in source) {
        target[key] = source[key]; // Vulnerable to prototype pollution
    }
    return target;
}

// Perbaikan:
function mergeObjectsSafe(target, source) {
    for (let key in source) {
        if (source.hasOwnProperty(key)) {
            target[key] = source[key];
        }
    }
    return target;
}
```

